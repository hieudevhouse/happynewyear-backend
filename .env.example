# Copy this file to .env, or run npm run setup from the repository root.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/lucky_money
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Exact frontend origins, separated by commas; no paths or trailing slashes.
CLIENT_ORIGIN=http://localhost:5173

# lax/strict works with frontend and API on the same site (e.g. sibling subdomains).
# For different sites: COOKIE_SAME_SITE=none, COOKIE_SECURE=true, and HTTPS.
COOKIE_SAME_SITE=lax
# Leave empty to use true in production and false otherwise.
COOKIE_SECURE=
# Number of trusted reverse proxy hops. Use 0 for a directly exposed API.
TRUST_PROXY=0

# Keep these server-side; use your own Cloudinary account settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lucky-money/qr
