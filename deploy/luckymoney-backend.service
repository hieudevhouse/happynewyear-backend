[Unit]
Description=LuckyMoney backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luckymoney
Group=luckymoney
WorkingDirectory=/srv/luckymoney/backend
Environment=NODE_ENV=production
# server.js loads /srv/luckymoney/backend/.env next to the entrypoint.
ExecStart=/usr/bin/node /srv/luckymoney/backend/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
